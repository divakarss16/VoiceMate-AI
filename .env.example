# Gnani.ai API Configuration
# Get your API Key from the Gnani.ai / Vachana Developer Portal: https://api.vachana.ai
GNANI_API_KEY=your_gnani_api_key_here

# Base URL for Gnani.ai Speech APIs (Default: https://api.vachana.ai)
GNANI_BASE_URL=https://api.vachana.ai

# Optional LLM / Evon Endpoint (Evon 30B is an open-weights model; configure if hosted or proxy available)
# GNANI_EVON_API_URL=https://your-evon-inference-endpoint.com/v1/chat/completions
# GNANI_EVON_API_KEY=your_evon_api_key

# Flask Application Settings
FLASK_SECRET_KEY=voicemate_super_secret_key_change_in_production
FLASK_ENV=development
PORT=5000

